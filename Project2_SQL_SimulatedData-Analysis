-- Stage 1: Exploratory -- 

-- Basic Stats - No of Campaigns by Year and Type
SELECT strftime('%Y', ca.send_date),
       ca.campaign_type,
       COUNT(*) AS no_campaigns
FROM Campaigns ca
GROUP BY 1, 2;

-- Basic Stats - No of Recepients by Year and Type
SELECT strftime('%Y', ca.send_date) AS year,
       ca.campaign_type,
       SUM(ca.total_recipients) AS no_recipients
FROM Campaigns ca
GROUP BY 1, 2;

-- Basic Stats - No of Customers by Year
