-- Q2. Campaign cost, discount spent, and total cost by year and campaign type
SELECT
    strftime('%Y', ca.send_date) AS year,
    ca.campaign_type,
    COUNT(ca.campaign_id) AS no_campaigns,
    SUM(ca.total_recipients) AS no_recipients,
    ROUND(SUM(ca.campaign_cost), 2) AS campaign_cost,
    SUM(log_stats.total_redeemed) AS total_redeemed,
    ROUND(SUM(log_stats.total_discount), 2) AS total_discount,
    ROUND(SUM(ca.campaign_cost) + SUM(log_stats.total_discount), 2) AS total_cost
FROM Campaigns ca
LEFT JOIN (
    SELECT 
        cl.campaign_id,
        SUM(cl.coupon_redeemed) AS total_redeemed,
        COALESCE(SUM(t.discount_amount), 0) AS total_discount
    FROM Campaign_Logs cl
    LEFT JOIN Transactions t ON cl.redemption_txn_id = t.transaction_id
    GROUP BY cl.campaign_id
) log_stats ON ca.campaign_id = log_stats.campaign_id
GROUP BY year, ca.campaign_type
ORDER BY year, ca.campaign_type;


-- Q3. Campaign funnel performance by campaign type
WITH campaign_funnel AS (
    SELECT
        ca.campaign_type,
        COUNT(cl.log_id) AS recipients,
        SUM(CASE WHEN cl.opened_at IS NOT NULL THEN 1 ELSE 0 END) AS opened,
        SUM(CASE WHEN cl.clicked_at IS NOT NULL THEN 1 ELSE 0 END) AS clicked,
        SUM(CASE WHEN cl.coupon_redeemed = 1 THEN 1 ELSE 0 END) AS redeemed
    FROM Campaigns ca
    LEFT JOIN Campaign_Logs cl ON ca.campaign_id = cl.campaign_id
    GROUP BY 1
)
SELECT *,
    ROUND(opened * 100.0 / recipients, 1) AS open_rate_pct,
    ROUND(clicked * 100.0 / recipients, 1) AS click_rate_pct,
    ROUND(clicked * 100.0 / NULLIF(opened, 0), 1) AS click_to_open_pct,
    ROUND(redeemed * 100.0 / recipients, 1) AS redemption_rate_pct,
    ROUND(redeemed * 100.0 / NULLIF(clicked, 0), 1) AS click_to_redemption_pct
FROM campaign_funnel
ORDER BY redemption_rate_pct DESC;


-- Q4. True cost per redemption by campaign (Exploratory)
SELECT 
    ca.campaign_id,
    ca.campaign_name,
    ca.campaign_type,
    ca.target_segment,
    ca.total_recipients,
    SUM(CASE WHEN cl.opened_at IS NOT NULL THEN 1 ELSE 0 END) AS no_opened,
    SUM(CASE WHEN cl.clicked_at IS NOT NULL THEN 1 ELSE 0 END) AS no_clicked,
    SUM(cl.coupon_redeemed) AS redeemed,
    ROUND(SUM(cl.coupon_redeemed) * 100.0 / COUNT(cl.log_id), 1) AS redemption_rate_pct,
    ca.campaign_cost,
    ROUND(ca.campaign_cost / NULLIF(SUM(cl.coupon_redeemed), 0), 2) AS cost_per_redemption,
    ROUND((ca.campaign_cost + COALESCE(SUM(t.discount_amount), 0))
        / NULLIF(SUM(cl.coupon_redeemed), 0), 2) AS true_cost_per_redemption,
    ROUND(COALESCE(SUM(t.discount_amount), 0), 2) AS total_discount_given
FROM Campaign_Logs cl
JOIN Campaigns ca ON cl.campaign_id = ca.campaign_id
LEFT JOIN Transactions t ON cl.redemption_txn_id = t.transaction_id
GROUP BY ca.campaign_id, ca.campaign_name, ca.campaign_type,
         ca.target_segment, ca.total_recipients, ca.campaign_cost
ORDER BY true_cost_per_redemption DESC;


-- Q5. Revenue and net attributed value by campaign type
WITH campaign_level AS (
    SELECT
        ca.campaign_id,
        ca.campaign_type,
        ca.campaign_cost,
        COUNT(cl.log_id) AS recipients,
        SUM(CASE WHEN cl.coupon_redeemed = 1 THEN 1 ELSE 0 END) AS redeemed,
        ROUND(SUM(CASE WHEN cl.redemption_txn_id IS NOT NULL 
            THEN t.total_amount ELSE 0 END), 2) AS attributed_redeemed_revenue,
        ROUND(SUM(CASE WHEN cl.redemption_txn_id IS NOT NULL 
            THEN t.discount_amount ELSE 0 END), 2) AS total_discount_given
    FROM Campaigns ca
    LEFT JOIN Campaign_Logs cl ON ca.campaign_id = cl.campaign_id
    LEFT JOIN Transactions t ON cl.redemption_txn_id = t.transaction_id
    GROUP BY ca.campaign_id, ca.campaign_type, ca.campaign_cost
)
SELECT
    campaign_type,
    SUM(redeemed) AS redeemed,
    ROUND(SUM(attributed_redeemed_revenue), 2) AS attributed_redeemed_revenue,
    ROUND(SUM(campaign_cost), 2) AS campaign_cost,
    ROUND(SUM(total_discount_given), 2) AS total_discount_given,
    ROUND(SUM(attributed_redeemed_revenue) / NULLIF(SUM(redeemed), 0), 2) AS revenue_per_redemption,
    ROUND(SUM(attributed_redeemed_revenue) - SUM(campaign_cost) 
        - SUM(total_discount_given), 2) AS net_attributed_value
FROM campaign_level
GROUP BY campaign_type
ORDER BY net_attributed_value DESC;


-- Q6. First-time vs existing customer redemption mix
WITH customer_first_purchase AS (
    SELECT customer_id,
           MIN(DATE(transaction_date)) AS first_purchase_date
    FROM Transactions
    WHERE status = 'Completed'
    GROUP BY customer_id
),
redeemed_txns AS (
    SELECT ca.campaign_type,
           cl.customer_id,
           DATE(t.transaction_date) AS redemption_date,
           t.total_amount
    FROM Campaign_Logs cl
    JOIN Campaigns ca ON cl.campaign_id = ca.campaign_id
    JOIN Transactions t ON cl.redemption_txn_id = t.transaction_id
    WHERE cl.coupon_redeemed = 1 AND t.status = 'Completed'
)
SELECT
    campaign_type,
    customer_status,
    redeemed_transactions,
    ROUND(redeemed_transactions * 100.0 /
        SUM(redeemed_transactions) OVER (PARTITION BY campaign_type), 1) AS redeemed_share_pct
FROM (
    SELECT r.campaign_type,
           CASE WHEN f.first_purchase_date = r.redemption_date 
               THEN 'First-time purchaser' ELSE 'Existing customer' END AS customer_status,
           COUNT(*) AS redeemed_transactions
    FROM redeemed_txns r
    JOIN customer_first_purchase f ON r.customer_id = f.customer_id
    GROUP BY r.campaign_type, customer_status
)
ORDER BY campaign_type, customer_status;


-- Q7. Static segment mix vs actual RFM mix
WITH recipient_base AS (
    SELECT
        cl.campaign_id,
        c.campaign_name,
        DATE(c.send_date) AS send_date,
        cl.customer_id,
        cu.customer_segment AS static_segment,

        MAX(DATE(t.transaction_date)) AS last_txn_date,
        COUNT(DISTINCT CASE 
            WHEN t.status = 'Completed' THEN DATE(t.transaction_date) 
        END) AS freq_visits,
        COALESCE(SUM(CASE 
            WHEN t.status = 'Completed' THEN t.total_amount 
        END), 0) AS monetary_value

    FROM Campaign_Logs cl
    JOIN Campaigns c
        ON cl.campaign_id = c.campaign_id
    JOIN Customers cu
        ON cl.customer_id = cu.customer_id
    LEFT JOIN Transactions t
        ON t.customer_id = cl.customer_id
       AND DATE(t.transaction_date) < DATE(c.send_date)

    WHERE strftime('%Y', c.send_date) = '2024'
    GROUP BY
        cl.campaign_id,
        c.campaign_name,
        DATE(c.send_date),
        cl.customer_id,
        cu.customer_segment
),

scored AS (
    SELECT
        *,
        CASE
            WHEN last_txn_date IS NULL THEN 9999
            ELSE CAST(julianday(send_date) - julianday(last_txn_date) AS INTEGER)
        END AS recency_days,

        6 - NTILE(5) OVER (
            PARTITION BY campaign_id
            ORDER BY CASE
                        WHEN last_txn_date IS NULL THEN 9999
                        ELSE julianday(send_date) - julianday(last_txn_date)
                     END ASC
        ) AS r_score,

        NTILE(5) OVER (
            PARTITION BY campaign_id
            ORDER BY freq_visits ASC
        ) AS f_score,

        NTILE(5) OVER (
            PARTITION BY campaign_id
            ORDER BY monetary_value ASC
        ) AS m_score
    FROM recipient_base
),

rfm_segmented AS (
    SELECT
        *,
        CASE
            WHEN last_txn_date IS NULL THEN 'New / No Prior Purchase'
            WHEN r_score >= 4 AND f_score >= 4 AND m_score >= 4 THEN 'Champions'
            WHEN r_score >= 4 AND f_score >= 3 AND m_score >= 3 THEN 'Loyal'
            WHEN r_score BETWEEN 2 AND 3 AND f_score >= 4 AND m_score >= 4 THEN 'At-Risk Loyal'
            WHEN r_score = 1 AND f_score >= 4 AND m_score >= 4 THEN 'Cannot Lose Them'
            WHEN r_score >= 3 AND f_score BETWEEN 2 AND 3 THEN 'New / Promising'
            WHEN r_score <= 2 AND f_score <= 2 AND m_score <= 2 THEN 'Lapsed'
            ELSE 'Mid-Tier'
        END AS rfm_segment
    FROM scored
),

segment_mix AS (
    SELECT
        static_segment,
        rfm_segment,
        COUNT(*) AS recipients
    FROM rfm_segmented
    GROUP BY
        static_segment,
        rfm_segment
)

SELECT
    static_segment,
    rfm_segment,
    recipients,
    ROUND(
        100.0 * recipients
        / SUM(recipients) OVER (PARTITION BY static_segment),
        1
    ) AS pct_within_static_segment
FROM segment_mix
ORDER BY
    static_segment,
    recipients DESC;


-- Q8. Redemption rate by RFM segment
WITH reference_date AS (
    SELECT MAX(DATE(transaction_date)) AS ref_date
    FROM Transactions
    WHERE status = 'Completed'
),
customer_metrics AS (
    SELECT
        c.customer_id,
        c.customer_segment AS static_segment,
        COUNT(DISTINCT DATE(t.transaction_date)) AS frequency,
        ROUND(SUM(t.total_amount), 2) AS monetary,
        MAX(DATE(t.transaction_date)) AS last_purchase_date
    FROM Customers c
    JOIN Transactions t
        ON c.customer_id = t.customer_id
    WHERE t.status = 'Completed'
    GROUP BY
        c.customer_id,
        c.customer_segment
),
rfm_scored AS (
    SELECT
        m.customer_id,
        m.static_segment,
        CAST(JULIANDAY(d.ref_date) - JULIANDAY(m.last_purchase_date) AS INTEGER) AS days_since_last_purchase,
        NTILE(5) OVER (
            ORDER BY JULIANDAY(d.ref_date) - JULIANDAY(m.last_purchase_date) ASC
        ) AS r_score,
        NTILE(5) OVER (ORDER BY m.frequency) AS f_score,
        NTILE(5) OVER (ORDER BY m.monetary) AS m_score
    FROM customer_metrics m
    CROSS JOIN reference_date d
),
rfm_labeled AS (
    SELECT
        customer_id,
        CASE
            WHEN r_score >= 4 AND f_score >= 4 AND m_score >= 4 THEN 'Champions'
            WHEN r_score >= 3 AND f_score >= 3 AND m_score >= 4 THEN 'Loyal'
            WHEN r_score >= 4 AND f_score <= 2 THEN 'New / promising'
            WHEN r_score <= 2 AND m_score >= 4 THEN 'Cannot lose them'
            WHEN r_score <= 2 AND f_score >= 3 AND m_score >= 3 THEN 'At-risk loyals'
            WHEN r_score <= 2 AND f_score <= 2 THEN 'Lapsed'
            ELSE 'Mid-tier'
        END AS rfm_segment
    FROM rfm_scored
),
recipient_base AS (
    SELECT
        cl.customer_id,
        cl.campaign_id,
        cl.coupon_redeemed
    FROM Campaign_Logs cl
    JOIN Campaigns c
        ON cl.campaign_id = c.campaign_id
    WHERE strftime('%Y', c.send_date) = '2024'
)
SELECT
    r.rfm_segment,
    COUNT(*) AS recipients,
    SUM(rb.coupon_redeemed) AS redemptions,
    ROUND(100.0 * SUM(rb.coupon_redeemed) / COUNT(*), 1) AS redemption_rate_pct
FROM recipient_base rb
JOIN rfm_labeled r
    ON rb.customer_id = r.customer_id
GROUP BY
    r.rfm_segment
ORDER BY
    redemption_rate_pct DESC;

