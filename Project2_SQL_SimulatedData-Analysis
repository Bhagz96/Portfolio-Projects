-- Q1. Which districts contribute the most customer value?
WITH customer_value AS (
    SELECT
  c.customer_id,
        c.district,
        SUM(t.total_amount) AS total_spend
    FROM Customers c
    JOIN Transactions t
        ON c.customer_id = t.customer_id
    WHERE t.status = 'Completed'
    GROUP BY c.customer_id, c.district
),
district_summary AS (
    SELECT
        district,
        COUNT(customer_id) AS total_customers,
        ROUND(SUM(total_spend), 2) AS district_total_revenue,
        ROUND(AVG(total_spend), 2) AS avg_customer_spend
    FROM customer_value
    GROUP BY district
),
total_revenue AS (
    SELECT SUM(district_total_revenue) AS overall_revenue
    FROM district_summary
)
SELECT
    d.district,
    d.total_customers,
    d.district_total_revenue,
    d.avg_customer_spend,
    ROUND(d.district_total_revenue * 100.0 / t.overall_revenue, 2) AS revenue_share_pct,
    DENSE_RANK() OVER (ORDER BY d.district_total_revenue DESC) AS district_revenue_rank
FROM district_summary d
CROSS JOIN total_revenue t
ORDER BY d.district_total_revenue DESC;

--Q2. Who is the highest-spending customer within each district?
WITH customer_value AS (
    SELECT
        c.customer_id,
        c.first_name || ' ' || c.last_name AS customer_name,
        c.district,
        COUNT(t.transaction_id) AS total_transactions,
        ROUND(SUM(t.total_amount), 2) AS total_spend,
        ROUND(AVG(t.total_amount), 2) AS avg_order_value
    FROM Customers c
    JOIN Transactions t
        ON c.customer_id = t.customer_id
    WHERE t.status = 'Completed'
    GROUP BY c.customer_id, c.first_name, c.last_name, c.district
),
ranked_customers AS (
    SELECT
        district,
        customer_id,
        customer_name,
        total_transactions,
        total_spend,
        avg_order_value,
        DENSE_RANK() OVER (
            PARTITION BY district
            ORDER BY total_spend DESC
        ) AS district_rank
    FROM customer_value
)
SELECT *
FROM ranked_customers
WHERE district_rank = 1
ORDER BY total_spend DESC;

--Q3. How concentrated is BrewCo’s customer base across districts?
WITH district_customers AS (
    SELECT
        district,
        COUNT(customer_id) AS total_customers
    FROM Customers
    GROUP BY district
),
total_base AS (
    SELECT SUM(total_customers) AS overall_customers
    FROM district_customers
),
ranked AS (
    SELECT
        d.district,
        d.total_customers,
ROUND(d.total_customers * 100.0 / t.overall_customers, 2) AS customer_share_pct
    FROM district_customers d
    CROSS JOIN total_base t
)
SELECT
    district,
    total_customers,
    customer_share_pct,
    ROUND(
        SUM(customer_share_pct) OVER (
            ORDER BY total_customers DESC
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ),
        2
    ) AS cumulative_customer_share_pct
FROM ranked
ORDER BY total_customers DESC;

--Q4. How strong is repeat purchase behaviour across districts?
WITH daily_purchases AS (
    SELECT
        t.customer_id,
        c.district,
        DATE(t.transaction_date) AS purchase_date
    FROM Transactions t
    JOIN Customers c
        ON t.customer_id = c.customer_id
    WHERE t.status = 'Completed'
    GROUP BY t.customer_id, c.district, DATE(t.transaction_date)
),
purchase_gaps AS (
    SELECT
        customer_id,
        district,
        purchase_date,
        JULIANDAY(purchase_date) - JULIANDAY(
            LAG(purchase_date) OVER (
                PARTITION BY customer_id
                ORDER BY purchase_date
            )
        ) AS days_between_purchases
FROM daily_purchases
),
customer_summary AS (
    SELECT
        customer_id,
        district,
        COUNT(purchase_date) AS visit_count,
        ROUND(AVG(days_between_purchases), 2) AS avg_days_between_purchases
    FROM purchase_gaps
    GROUP BY customer_id, district
),
repeat_classified AS (
    SELECT
        customer_id,
        district,
        CASE
            WHEN visit_count = 1 THEN 'One-time'
            WHEN avg_days_between_purchases <= 30 THEN 'Frequent repeat'
            WHEN avg_days_between_purchases <= 60 THEN 'Moderate repeat'
            ELSE 'Infrequent repeat'
        END AS repeat_behaviour
    FROM customer_summary
)
SELECT
    district,
    repeat_behaviour,
    COUNT(*) AS customer_count,
    ROUND(
        COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (PARTITION BY district),
        2
    ) AS district_share_pct
FROM repeat_classified
GROUP BY district, repeat_behaviour
ORDER BY district, district_share_pct DESC;

--Q5. How does retention status vary across districts?\
WITH reference_date AS (
    SELECT MAX(DATE(transaction_date)) AS ref_date
    FROM Transactions
    WHERE status = 'Completed'
),
customer_recency AS (
SELECT
        c.customer_id,
        c.district,
        MAX(DATE(t.transaction_date)) AS last_purchase_date
    FROM Customers c
    JOIN Transactions t
        ON c.customer_id = t.customer_id
    WHERE t.status = 'Completed'
    GROUP BY c.customer_id, c.district
),
classified AS (
    SELECT
        district,
        customer_id,
        CASE
            WHEN JULIANDAY((SELECT ref_date FROM reference_date)) - JULIANDAY(last_purchase_date) <= 30 THEN 'Active'
            WHEN JULIANDAY((SELECT ref_date FROM reference_date)) - JULIANDAY(last_purchase_date) <= 60 THEN 'Warm'
            WHEN JULIANDAY((SELECT ref_date FROM reference_date)) - JULIANDAY(last_purchase_date) <= 90 THEN 'At Risk'
            ELSE 'Lapsed'
        END AS retention_status
    FROM customer_recency
)
SELECT
    district,
    retention_status,
    COUNT(*) AS customer_count,
    ROUND(
        COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (PARTITION BY district),
        2
    ) AS district_share_pct
FROM classified
GROUP BY district, retention_status
ORDER BY district, district_share_pct DESC;

--Q6. What type of customers make up each district?
WITH reference_date AS (
    SELECT MAX(DATE(transaction_date)) AS ref_date
    FROM Transactions
    WHERE status = 'Completed'
),
customer_metrics AS (
    SELECT
        c.customer_id,
        c.district,
        COUNT(DISTINCT DATE(t.transaction_date)) AS total_visits,
        COUNT(t.transaction_id) AS total_transactions,
        ROUND(SUM(t.total_amount), 2) AS total_spend,
        ROUND(AVG(t.total_amount), 2) AS avg_order_value,
        MAX(DATE(t.transaction_date)) AS last_purchase_date
    FROM Customers c
    JOIN Transactions t
        ON c.customer_id = t.customer_id
    WHERE t.status = 'Completed'
    GROUP BY c.customer_id, c.district
),
customer_with_quintile AS (
    SELECT
        cm.*,
        CAST(
            JULIANDAY(d.ref_date) - JULIANDAY(cm.last_purchase_date)
            AS INTEGER
        ) AS days_since_last_purchase,
        NTILE(5) OVER (ORDER BY cm.total_spend) AS spend_quintile
    FROM customer_metrics cm
    CROSS JOIN reference_date d
),
segmented AS (
    SELECT
        district,
        customer_id,
        total_spend,
        CASE
            WHEN spend_quintile >= 4
                 AND total_visits >= 3
                 AND days_since_last_purchase <= 60
                THEN 'High-value loyal'
            WHEN spend_quintile >= 4
                 AND total_visits >= 3
                 AND days_since_last_purchase > 60
                THEN 'High-value at risk'
            WHEN spend_quintile < 4
                 AND total_visits >= 3
                THEN 'Low-value repeat'
            ELSE 'Occasional/one-time'
        END AS customer_segment_label
    FROM customer_with_quintile
)
SELECT
    district,
    customer_segment_label,
    COUNT(*) AS customer_count,
    ROUND(SUM(total_spend), 2) AS segment_revenue,
    ROUND(
        COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (PARTITION BY district),
        2
    ) AS district_share_pct
FROM segmented
GROUP BY district, customer_segment_label
ORDER BY district, district_share_pct DESC;

--Q7. How are customers classified under the RFM framework?
WITH reference_date AS (
    SELECT MAX(DATE(transaction_date)) AS ref_date
    FROM Transactions
    WHERE status = 'Completed'
),
customer_metrics AS (
    SELECT
        c.customer_id,
        c.district,
        COUNT(DISTINCT DATE(t.transaction_date)) AS frequency,
        ROUND(SUM(t.total_amount), 2) AS monetary,
        MAX(DATE(t.transaction_date)) AS last_purchase_date
    FROM Customers c
    JOIN Transactions t
        ON c.customer_id = t.customer_id
    WHERE t.status = 'Completed'
    GROUP BY c.customer_id, c.district
),
rfm_scored AS (
    SELECT
        m.customer_id,
        m.district,
        6 - NTILE(5) OVER (
            ORDER BY JULIANDAY(d.ref_date) - JULIANDAY(m.last_purchase_date)
        ) AS r_score,
 NTILE(5) OVER (ORDER BY m.frequency) AS f_score,
        NTILE(5) OVER (ORDER BY m.monetary) AS m_score
    FROM customer_metrics m
    CROSS JOIN reference_date d
),
rfm_segmented AS (
    SELECT
        district,
        customer_id,
        CASE
            WHEN r_score >= 4 AND f_score >= 4 AND m_score >= 4 THEN 'Champions'
            WHEN r_score >= 3 AND f_score >= 3 AND m_score >= 4 THEN 'Loyal'
            WHEN r_score >= 4 AND f_score <= 2 THEN 'New/promising'
            WHEN r_score <= 2 AND m_score >= 4 THEN 'Cannot lose them'
            WHEN r_score <= 2 AND f_score >= 3 AND m_score < 4 THEN 'At-risk loyals'
            WHEN r_score <= 2 AND f_score <= 2 THEN 'Lapsed'
            ELSE 'Mid-tier'
        END AS rfm_segment
    FROM rfm_scored
)
SELECT
    district,
    rfm_segment,
    COUNT(*) AS customer_count,
    ROUND(
        COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (PARTITION BY district),
        2
    ) AS district_share_pct
FROM rfm_segmented
GROUP BY district, rfm_segment
ORDER BY district, district_share_pct DESC;

--Q8. Which districts combine strong customer value with higher risk exposure?
--For Scatter plot
WITH district_revenue AS (
    SELECT
        c.district,
        ROUND(SUM(t.total_amount), 2) AS district_total_revenue
    FROM Customers c
    JOIN Transactions t
        ON c.customer_id = t.customer_id
    WHERE t.status = 'Completed'
    GROUP BY c.district
),
district_ranked AS (
    SELECT
        district,
        district_total_revenue,
        DENSE_RANK() OVER (
            ORDER BY district_total_revenue DESC
        ) AS district_value_rank
    FROM district_revenue
),
reference_date AS (
    SELECT MAX(DATE(transaction_date)) AS ref_date
    FROM Transactions
    WHERE status = 'Completed'
),
customer_metrics AS (
    SELECT
        c.customer_id,
        c.district,
        COUNT(DISTINCT DATE(t.transaction_date)) AS frequency,
        ROUND(SUM(t.total_amount), 2) AS monetary,
        MAX(DATE(t.transaction_date)) AS last_purchase_date
    FROM Customers c
    JOIN Transactions t
        ON c.customer_id = t.customer_id
    WHERE t.status = 'Completed'
    GROUP BY c.customer_id, c.district
),
rfm_scored AS (
    SELECT
        m.customer_id,
        m.district,
        6 - NTILE(5) OVER (
            ORDER BY JULIANDAY(d.ref_date) - JULIANDAY(m.last_purchase_date)
        ) AS r_score,
        NTILE(5) OVER (ORDER BY m.frequency) AS f_score,
        NTILE(5) OVER (ORDER BY m.monetary) AS m_score
    FROM customer_metrics m
    CROSS JOIN reference_date d
),
rfm_segmented AS (
    SELECT
        district,
        customer_id,
        CASE
            WHEN r_score >= 4 AND f_score >= 4 AND m_score >= 4 THEN 'Champions'
            WHEN r_score >= 3 AND f_score >= 3 AND m_score >= 4 THEN 'Loyal'
            WHEN r_score >= 4 AND f_score <= 2 THEN 'New / promising'
            WHEN r_score <= 2 AND m_score >= 4 THEN 'Cannot lose them'
            WHEN r_score <= 2 AND f_score >= 3 AND m_score < 4 THEN 'At-risk loyals'
            WHEN r_score <= 2 AND f_score <= 2 THEN 'Lapsed'
            ELSE 'Mid-tier'
        END AS rfm_segment
    FROM rfm_scored
),
district_rfm_summary AS (
    SELECT
        district,
        rfm_segment,
        COUNT(*) AS customer_count,
        ROUND(
            COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (PARTITION BY district),
            2
        ) AS district_share_pct
    FROM rfm_segmented
    GROUP BY district, rfm_segment
)
SELECT
    d.district,
    d.district_total_revenue,
    d.district_value_rank,
    ROUND(SUM(CASE
        WHEN s.rfm_segment IN ('Champions', 'Loyal')
        THEN s.district_share_pct
        ELSE 0
    END), 2) AS strong_value_base_pct,
    ROUND(SUM(CASE
        WHEN s.rfm_segment IN ('Cannot lose them', 'At-risk loyals')
        THEN s.district_share_pct
        ELSE 0
    END), 2) AS risk_exposure_pct
FROM district_rfm_summary s
JOIN district_ranked d
    ON s.district = d.district
GROUP BY
    d.district,
    d.district_total_revenue,
    d.district_value_rank
ORDER BY d.district_value_rank;


