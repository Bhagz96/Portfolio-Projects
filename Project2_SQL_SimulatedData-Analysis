-- Q1: Which products and bundles generate the most revenue according to ?
--By Single Item
SELECT
    p.product_name,
    p.category,
    SUM(ti.line_total)                                   AS total_revenue,
    SUM(ti.quantity)                                     AS total_units_sold,
    ROUND(SUM(ti.line_total) / SUM(ti.quantity), 2)      AS avg_revenue_per_unit
FROM Transaction_Items ti
JOIN Products     p  ON ti.product_id = p.product_id
JOIN Transactions t  ON ti.transaction_id = t.transaction_id
WHERE t.status      = 'Completed'
  AND ti.product_id IS NOT NULL       
GROUP BY p.product_id, p.product_name, p.category
ORDER BY total_revenue DESC
LIMIT 10;

--By bundle
 SELECT
    p.bundle_name,
    SUM(ti.line_total) AS total_revenue,
    SUM(ti.quantity)   AS total_units_sold,
    ROUND(100.0 * SUM(ti.line_total) /
          SUM(SUM(ti.line_total)) OVER (), 2) AS revenue_share_pct
FROM Transaction_Items ti
JOIN Products p      ON ti.product_id = p.product_id
JOIN Transactions t  ON ti.transaction_id = t.transaction_id
WHERE t.status = 'Completed'
  AND ti.product_id IS NOT NULL
  AND p.bundle_name IS NOT NULL
GROUP BY p.bundle_name
ORDER BY total_revenue DESC;

--Q2: Which bundle combinations sell best? Which of them are out-performing / under-performing? 
WITH bundle_metrics AS (
    SELECT 
        b.bundle_id,
        b.bundle_name,
        COUNT(DISTINCT ti.transaction_id) AS transactions,
        SUM(ti.quantity)                  AS total_units_sold,
        SUM(ti.line_total)                AS total_revenue
    FROM Transaction_Items ti
    JOIN Bundles b       ON ti.bundle_id = b.bundle_id
    JOIN Transactions t  ON ti.transaction_id = t.transaction_id
    WHERE t.status = 'Completed'
    GROUP BY b.bundle_id, b.bundle_name
)

SELECT
    bundle_name,
    transactions,
    total_units_sold,
    total_revenue,

    -- revenue share 
    ROUND(100.0 * total_revenue / 
          SUM(total_revenue) OVER (), 2) AS revenue_share_pct,

    -- avg revenue per transaction
    ROUND(total_revenue * 1.0 / transactions, 2) AS avg_revenue_per_txn,

    -- avg price per unit 
    ROUND(total_revenue * 1.0 / total_units_sold, 2) AS avg_price_per_unit

FROM bundle_metrics
ORDER BY total_revenue DESC;

--Q3: How does the sales channel shape bundle adoption and transaction composition?
WITH txn_type AS (
    SELECT
        t.transaction_id,
        t.channel,
        CASE 
            WHEN SUM(CASE WHEN ti.bundle_id IS NOT NULL THEN 1 ELSE 0 END) > 0
                THEN 'Bundle Purchase'
            ELSE 'Single Item Purchase'
        END AS purchase_type
    FROM Transactions t
    JOIN Transaction_Items ti 
        ON t.transaction_id = ti.transaction_id
    WHERE t.status = 'Completed'
    GROUP BY t.transaction_id, t.channel
)

SELECT
    channel,
    purchase_type,
    COUNT(*) AS transactions,
    
    SUM(COUNT(*)) OVER (PARTITION BY channel) AS total_channel_transactions,
    
    ROUND(100.0 * COUNT(*) /
          SUM(COUNT(*)) OVER (PARTITION BY channel), 1) AS pct_within_channel

FROM txn_type
GROUP BY channel, purchase_type
ORDER BY channel, purchase_type;

